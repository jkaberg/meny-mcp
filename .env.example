# Copy to .env next to docker-compose.yml.

# Hostname the reverse proxy serves this on.
DOMAIN=example.com

# Your shop. Find its GLN with the find_stores tool.
MENY_STORE_ID=7080001271947

# --- Optional: the weekly menu toolset (docs/ukemeny.md) -----------------
# These tools WRITE to Mealie. Over HTTP they stay hidden unless
# MENY_AUTH_TOKEN is also set, and callers reach them at /mcp/<token>.
MEALIE_URL=https://mealie.example.com
MEALIE_TOKEN=

# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
# Minimum 24 characters; a shorter one is refused rather than trusted.
MENY_AUTH_TOKEN=
